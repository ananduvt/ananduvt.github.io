---
const links = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "GitHub", href: "https://github.com/ananduvt", external: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A little corner of the internet belonging to Anandu."
    />
    <meta name="theme-color" content="#f7f6f2" />
    <title>Anandu — Home</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label="Anandu home">a.</a>
        <nav aria-label="Main navigation">
          {
            links.map(({ label, href, external }) => (
              <a href={href} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
                {label}
                {external && <span class="external-mark" aria-hidden="true">↗</span>}
              </a>
            ))
          }
        </nav>
      </header>

      <main id="top">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="availability-dot"></span> A personal corner of the web</p>
            <h1 id="hero-title">Hello, I’m <span>Anandu.</span></h1>
            <p class="intro">
              Welcome to my little corner of the internet. I’m glad you’re here.
            </p>
            <a class="text-link" href="#about">
              A little more about me <span aria-hidden="true">↓</span>
            </a>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit orbit-three"></div>
            <div class="sun"></div>
            <span class="art-label">CURIOUS BY NATURE</span>
            <span class="art-number">01 / ∞</span>
          </div>
          <span class="hero-index" aria-hidden="true">01</span>
        </section>

        <section class="about section-grid" id="about" aria-labelledby="about-title">
          <p class="section-label">01 / A LITTLE ABOUT ME</p>
          <div class="section-content">
            <h2 id="about-title">A place to start.</h2>
            <p>
              This is my home on the web — a space for the things I make, the
              ideas I’m exploring, and whatever I feel like sharing along the way.
            </p>
            <a
              class="inline-link"
              href="https://github.com/ananduvt"
              target="_blank"
              rel="noreferrer"
            >
              Find me on GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>

        <section class="projects section-grid" id="projects" aria-labelledby="projects-title">
          <p class="section-label">02 / WHAT’S HERE</p>
          <div class="section-content">
            <h2 id="projects-title">Room to grow.</h2>
            <p>
              I’m just getting this space started. Check back as I add projects,
              notes, and more to explore.
            </p>
            <div class="coming-soon">
              <span class="coming-soon-mark" aria-hidden="true">✳</span>
              <span>More things are on the way</span>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <a class="wordmark footer-mark" href="#top" aria-label="Back to top">a.</a>
        <p>Made with care, one page at a time.</p>
        <a
          class="footer-link"
          href="https://github.com/ananduvt"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 2rem;
  }

  :global(body) {
    margin: 0;
    background: #f7f6f2;
    color: #242923;
    font-family: "DM Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(body)::before {
    position: fixed;
    z-index: -1;
    background-image: radial-gradient(#4e574b 0.45px, transparent 0.45px);
    background-size: 7px 7px;
    content: "";
    inset: 0;
    opacity: 0.07;
    pointer-events: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    border-radius: 3px;
    outline: 2px solid #52745e;
    outline-offset: 5px;
  }

  .page-shell {
    width: min(100% - 96px, 1120px);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    height: 88px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #dfdfd7;
  }

  .wordmark {
    color: #50705a;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.12em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  nav a,
  .footer-link {
    color: #555a51;
    font-size: 13px;
    transition: color 160ms ease;
  }

  nav a:hover,
  .footer-link:hover {
    color: #50705a;
  }

  .external-mark {
    margin-left: 4px;
    color: #8b9085;
    font-size: 11px;
  }

  .hero {
    position: relative;
    display: grid;
    min-height: 580px;
    align-items: center;
    grid-template-columns: 1.08fr 0.92fr;
    border-bottom: 1px solid #dfdfd7;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding-block: 80px;
  }

  .eyebrow,
  .section-label,
  .art-label,
  .art-number {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 31px;
    color: #6c7168;
  }

  .availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6b916f;
    box-shadow: 0 0 0 4px #6b916f1c;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 620px;
    margin-bottom: 23px;
    font-size: clamp(56px, 7.4vw, 91px);
    font-weight: 500;
    letter-spacing: -0.085em;
    line-height: 0.98;
  }

  h1 span {
    color: #638069;
    font-family: Georgia, serif;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.09em;
  }

  .intro {
    max-width: 350px;
    margin-bottom: 33px;
    color: #73776e;
    font-size: 16px;
    line-height: 1.8;
  }

  .text-link,
  .inline-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #45654e;
    font-size: 13px;
    font-weight: 600;
  }

  .text-link span,
  .inline-link span,
  .footer-link span {
    transition: transform 160ms ease;
  }

  .text-link:hover span {
    transform: translateY(3px);
  }

  .hero-art {
    position: relative;
    width: min(100%, 405px);
    aspect-ratio: 1;
    justify-self: end;
    overflow: hidden;
    border-radius: 50%;
    background: #e9ebe1;
  }

  .hero-art::before,
  .hero-art::after {
    position: absolute;
    border: 1px solid #cfd5c8;
    border-radius: 50%;
    content: "";
    inset: 12%;
  }

  .hero-art::after {
    inset: 23%;
    border-color: #d5d9ce;
  }

  .orbit {
    position: absolute;
    z-index: 1;
    border: 1px solid #becbbd;
    border-radius: 50%;
  }

  .orbit-one {
    width: 123%;
    height: 51%;
    top: 25%;
    left: -11%;
    transform: rotate(-35deg);
  }

  .orbit-two {
    width: 123%;
    height: 51%;
    top: 25%;
    left: -11%;
    transform: rotate(35deg);
  }

  .orbit-three {
    width: 77%;
    height: 77%;
    top: 11.5%;
    left: 11.5%;
    border-color: #d2d8cd;
  }

  .sun {
    position: absolute;
    width: 32%;
    aspect-ratio: 1;
    top: 34%;
    left: 34%;
    border-radius: 50%;
    background: #d7a66f;
    box-shadow: 0 0 64px #d7a66f4d;
  }

  .art-label,
  .art-number {
    position: absolute;
    z-index: 2;
    color: #687361;
    font-size: 8px;
  }

  .art-label {
    top: 18%;
    left: 50%;
    transform: translateX(-50%);
  }

  .art-number {
    right: 20%;
    bottom: 20%;
  }

  .hero-index {
    position: absolute;
    right: 0;
    bottom: 24px;
    color: #a8aa9f;
    font-family: "DM Mono", monospace;
    font-size: 10px;
  }

  .section-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 40px;
    padding: 91px 0 96px;
    border-bottom: 1px solid #dfdfd7;
  }

  .section-label {
    margin: 9px 0 0;
    color: #83877d;
  }

  .section-content {
    max-width: 510px;
  }

  h2 {
    margin-bottom: 17px;
    font-size: clamp(31px, 4vw, 43px);
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .section-content > p {
    max-width: 450px;
    margin-bottom: 24px;
    color: #73776e;
    font-size: 15px;
    line-height: 1.85;
  }

  .inline-link:hover span,
  .footer-link:hover span {
    transform: translate(2px, -2px);
  }

  .coming-soon {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    padding: 12px 15px;
    border: 1px solid #dedfd5;
    border-radius: 3px;
    color: #74796f;
    font-size: 12px;
  }

  .coming-soon-mark {
    color: #81947a;
    font-size: 16px;
  }

  .site-footer {
    display: flex;
    min-height: 105px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-mark {
    font-size: 25px;
  }

  .site-footer p {
    margin: 0;
    color: #85897f;
    font-size: 11px;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .page-shell {
      width: min(100% - 40px, 520px);
    }

    .site-header {
      height: 72px;
    }

    nav {
      gap: 20px;
    }

    nav a {
      font-size: 12px;
    }

    .hero {
      min-height: auto;
      padding: 74px 0 62px;
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .hero-copy {
      padding: 0;
    }

    .hero-art {
      width: min(78%, 330px);
      justify-self: center;
    }

    h1 {
      font-size: clamp(58px, 14vw, 82px);
    }

    .hero-index {
      bottom: 20px;
    }

    .section-grid {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 61px 0 65px;
    }

    .section-label {
      margin: 0;
    }
  }

  @media (max-width: 420px) {
    .page-shell {
      width: calc(100% - 36px);
    }

    nav {
      gap: 14px;
    }

    .site-footer p {
      max-width: 145px;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>
