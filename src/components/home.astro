---
import SideRays from "../React/SideRays.jsx";
import portrait from "../images/Anandu-casual-photo.jpg";
---

<section class="text-[var(--white)] min-h-[100svh] flex items-center" id="home">
  <div class="home-rays" aria-hidden="true">
    <SideRays
      client:load
      rayColor1="#884cff"
      rayColor2="#dd7010"
      blend={0.4}
      origin="top-left"
      speed={0.45}
      intensity={4.4}
      spread={2}
      density={5}
      sharpness={0.8}
      glow={0.25}
      saturation={0.9}
      dust={0}
      followMouse={true}
      intro={true}
      opacity={1}
      maxDevicePixelRatio={1.5}
    />
  </div>
  <div class="max-w-7xl w-full mx-auto space-y-8 px-6 md:py-36 pb-14">
    <div class="identity-grid">
      <div class="portrait-panel">
        <div class="portrait-placeholder">
          <img
            class="portrait-photo"
            src={portrait.src}
            alt="Anandu V T"
            width={portrait.width}
            height={portrait.height}
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="identity-copy">
        <h1 class="identity-name">Anandu</h1>
        <h1 class="identity-name">Thulaseedharan</h1>
        <p class="identity-titles">Engineer <span>·</span> Tinkerer <span>·</span> Automator</p>
        <p class="identity-description">
          My virtual workbench for all the things I build.<br />
          I’m driven by technology, creative problem-solving.<br />
          And a stubborn refusal to buy things.<br />
          Particularly if I can over-engineer them myself.<br />
          Will be sharing updates from my software & electrical projects.<br />
          And whatever else I’m currently building (and re-building).
        </p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  #home {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .home-rays {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    inset: 0;
  }

  .home-rays .side-rays {
    position: absolute;
    inset: 0;
    opacity: 0.9;
    mask-image: linear-gradient(to bottom, #000 0%, #000 68%, transparent 100%);
  }

  #home > .max-w-7xl {
    position: relative;
    z-index: 1;
  }

  .shiny-sec {
    background: linear-gradient(135deg, var(--accent-purple) 25%, #eee5ff 50%, var(--accent-purple) 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  .identity-grid {
    display: grid;
    min-height: 490px;
    align-items: stretch;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 48px;
  }

  .portrait-panel {
    grid-column: 2;
  }

  .portrait-panel {
    position: relative;
    display: flex;
    min-height: 490px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 18px;
    background: transparent;
  }

  .portrait-panel::before {
    position: absolute;
    inset: 20% 5%;
    z-index: 0;
    border: 1px solid rgb(var(--accent-amber-rgb) / 0.5);
    border-radius: 50%;
    content: "";
    pointer-events: none;
    transform: rotate(-24deg);
    animation: portrait-orbit-forward 78s linear infinite;
  }

  .portrait-panel::after {
    position: absolute;
    inset: 29% 0;
    z-index: 0;
    border: 1px solid #dfdfdf14;
    border-radius: 50%;
    content: "";
    pointer-events: none;
    transform: rotate(32deg);
    animation: portrait-orbit-reverse 105s linear infinite;
  }

  .portrait-placeholder {
    position: relative;
    z-index: 1;
    width: min(70%, 310px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 14px;
    background: #101012;
    box-shadow: 0 18px 70px #0008, inset 0 0 45px rgb(var(--accent-purple-rgb) / 0.06);
  }

  .portrait-photo {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: 50% 25%;
  }

  @keyframes portrait-orbit-forward {
    to {
      transform: rotate(336deg);
    }
  }

  @keyframes portrait-orbit-reverse {
    to {
      transform: rotate(-328deg);
    }
  }

  .identity-copy {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
  }

  .identity-eyebrow {
    margin-bottom: 10px;
    color: var(--white-icon);
    font-size: 16px;
  }

  .identity-name {
    margin-bottom: 14px;
    color: var(--white);
    font-size: clamp(42px, 5.3vw, 68px);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 1.05;
  }

  .identity-titles {
    margin-bottom: 24px;
    color: var(--sec);
    font-size: clamp(15px, 1.8vw, 19px);
    font-weight: 500;
  }

  .identity-titles span {
    padding-inline: 4px;
    color: #7f7889;
  }

  .identity-description {
    max-width: 680px;
    margin-bottom: 26px;
    color: var(--white-icon);
    font-size: 15px;
    line-height: 1.9;
  }

  .identity-description strong {
    display: block;
    margin-bottom: 8px;
    color: var(--white);
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .identity-grid {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .portrait-panel {
      grid-column: 1;
      grid-row: 1;
      min-height: 390px;
    }

    .identity-copy {
      grid-column: 1;
      grid-row: 2;
      align-items: flex-start;
      text-align: left;
    }

    .identity-name {
      font-size: clamp(44px, 11vw, 64px);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .portrait-panel::before,
    .portrait-panel::after {
      animation: none;
    }
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }

    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
