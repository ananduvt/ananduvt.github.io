---
import LetterGlitch from "../React/LetterGlitch.tsx";
import SkillsList from "../React/SkillsList.tsx";
import LogoWall from "../components/logoWall.astro";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-7xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="identity-grid">
      <div class="portrait-panel">
        <div class="portrait-placeholder">
          <img
            class="portrait-photo"
            src="/images/anandu-casual-photo.jpg"
            alt="Anandu V T"
            width="1733"
            height="2560"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="identity-copy">
        <h1 class="identity-name">Anandu</h1>
        <p class="identity-titles">Engineer <span>·</span> Tinkerer <span>·</span> Automator</p>
        <p class="identity-description">
          My virtual workbench for all the things I build.<br />
          I’m driven by technology, creative problem-solving.<br />
          And a stubborn refusal to buy things.<br />
          Particularly if I can over-engineer them myself.<br />
          Will be sharing updates from my software & electrical projects.<br />
          And whatever else I’m currently building (and re-building).
        </p>
      </div>
    </div>

    <div>
      <p class="text-sm text-[var(--white-icon)] text-center">
        A few of the tools behind this site
      </p>
      <LogoWall />
    </div>

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16">
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  .identity-grid {
    display: grid;
    min-height: 490px;
    align-items: stretch;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 48px;
  }

  .portrait-panel {
    position: relative;
    display: flex;
    min-height: 490px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 18px;
    background:
      radial-gradient(ellipse at 50% 46%, #5e449155 0, transparent 48%),
      linear-gradient(145deg, #19171e, #101010 72%);
  }

  .portrait-panel::before {
    position: absolute;
    border-radius: 50%;
    content: "";
    inset: 9%;
  }

  .portrait-placeholder {
    position: relative;
    width: min(70%, 310px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 14px;
    background: #101012;
    box-shadow: 0 18px 70px #0008, inset 0 0 45px #a476ff0e;
  }

  .portrait-photo {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: 50% 25%;
    transform: scaleX(-1);
  }

  .identity-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    text-align: right;
  }

  .identity-eyebrow {
    margin-bottom: 10px;
    color: var(--white-icon);
    font-size: 16px;
  }

  .identity-name {
    margin-bottom: 14px;
    color: var(--white);
    font-size: clamp(42px, 5.3vw, 68px);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 1.05;
  }

  .identity-titles {
    margin-bottom: 24px;
    color: var(--sec);
    font-size: clamp(15px, 1.8vw, 19px);
    font-weight: 500;
  }

  .identity-titles span {
    padding-inline: 4px;
    color: #7f7889;
  }

  .identity-description {
    max-width: 680px;
    margin-bottom: 26px;
    color: var(--white-icon);
    font-size: 15px;
    line-height: 1.9;
  }

  .identity-description strong {
    display: block;
    margin-bottom: 8px;
    color: var(--white);
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .identity-grid {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .portrait-panel {
      min-height: 390px;
    }

    .identity-copy {
      align-items: flex-start;
      text-align: left;
    }

    .identity-name {
      font-size: clamp(44px, 11vw, 64px);
    }

  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
